{
  "name": "galavi",
  "version": "2026.4.30",
  "description": "Scientific data visualization library based on WebGPU",
  "keywords": ["webgpu", "visualization", "ome-zarr", "scientific", "3d", "microscopy"],
  "author": "Zi-Jian Yi (伊子健) <arrowzeke@gmail.com>",
  "license": "GPL-3.0",
  "homepage": "https://github.com/i-z-j/galavi",
  "bugs": {
    "url": "https://github.com/i-z-j/galavi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-z-j/galavi.git"
  },
  "type": "module",
  "main": "dist/galavi.js",
  "module": "dist/galavi.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/galavi.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "wgpu-matrix": "^3.4.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.65",
    "bun-types": "^1.2.22",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.5.0"
  }
}
