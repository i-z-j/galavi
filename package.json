{
  "name": "galavi",
  "version": "2026.8.1",
  "description": "Dataset-to-Viewer infrastructure for scientific WebGPU viewers: a declarative Dataset boundary, an application-facing Viewer boundary, and the reusable rendering infrastructure between them",
  "keywords": ["webgpu", "visualization", "ome-zarr", "scientific", "3d", "microscopy"],
  "author": "Zi-Jian Yi (伊子健) <arrowzeke@gmail.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/i-z-j/galavi",
  "bugs": {
    "url": "https://github.com/i-z-j/galavi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-z-j/galavi.git"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/galavi.js"
    },
    "./ome-zarr": {
      "types": "./dist/dataset/adapters/ome-zarr.d.ts",
      "import": "./dist/ome-zarr.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/ome-zarr.js"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:pack": "node scripts/check-pack.mjs",
    "deps": "madge --extensions ts --ts-config tsconfig.json --circular src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "wgpu-matrix": "^3.4.0",
    "zarrita": "^0.6.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.65",
    "bun-types": "^1.2.22",
    "jsdom": "^29.1.1",
    "madge": "^8.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.10"
  }
}
